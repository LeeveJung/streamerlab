---
// ConsentBanner.astro - DSGVO Cookie & Ad Consent Banner
---

<div
  id="consent-banner"
  class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:max-w-md z-50 bg-zinc-900 border border-zinc-800 p-5 rounded-xl shadow-2xl space-y-4 hidden"
>
  <div class="space-y-1">
    <h3 class="text-sm font-semibold text-white flex items-center gap-2">
      <svg
        class="w-4 h-4 text-red-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
        ></path>
      </svg>
      Privacy & Advertising
    </h3>
    <p class="text-xs text-zinc-400 leading-relaxed">
      We use cookies and ads (for example Google AdSense) to keep this tool
      free. Advertising scripts are only loaded once you agree.
    </p>
  </div>

  <div class="flex items-center gap-2 pt-1">
    <button
      type="button"
      id="btn-accept-all"
      class="w-full py-2 px-3 text-xs font-semibold rounded-lg bg-red-600 hover:bg-red-500 text-white transition-colors"
    >
      Accept all
    </button>
    <button
      type="button"
      id="btn-accept-essential"
      class="w-full py-2 px-3 text-xs font-medium rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 transition-colors"
    >
      Essential only
    </button>
  </div>
</div>

<script>
  import {
    getConsentStatus,
    setConsentStatus,
    loadAdSenseScript,
  } from "../scripts/consent-manager";

  // ERSETZEN mit deiner echten Google AdSense Publisher ID (z.B. ca-pub-1234567890)
  const ADSENSE_PUBLISHER_ID = "ca-pub-XXXXXXXXXXXXXXXX";

  const banner = document.getElementById("consent-banner");
  const btnAcceptAll = document.getElementById("btn-accept-all");
  const btnAcceptEssential = document.getElementById("btn-accept-essential");

  const currentStatus = getConsentStatus();

  // Bei vorhandener Zustimmung sofort AdSense laden
  if (currentStatus === "granted") {
    loadAdSenseScript(ADSENSE_PUBLISHER_ID);
  } else if (currentStatus === "pending") {
    banner?.classList.remove("hidden");
  }

  // Button Listeners
  btnAcceptAll?.addEventListener("click", () => {
    setConsentStatus("granted");
    loadAdSenseScript(ADSENSE_PUBLISHER_ID);
    banner?.classList.add("hidden");
  });

  btnAcceptEssential?.addEventListener("click", () => {
    setConsentStatus("denied");
    banner?.classList.add("hidden");
  });
</script>
