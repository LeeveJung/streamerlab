---
// Footer.astro
---

<footer
  class="w-full border-t border-zinc-800/80 mt-16 py-8 bg-zinc-950 text-zinc-500 text-xs"
>
  <div
    class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4"
  >
    <p>
      © {new Date().getFullYear()} YouTube Thumbnail Tester. All images are processed
      locally in your browser.
    </p>
    <div class="flex gap-6">
      <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
      <a href="/legal-notice/" class="hover:text-zinc-300 transition-colors"
        >Legal Notice</a
      >
      <a href="/privacy-policy/" class="hover:text-zinc-300 transition-colors"
        >Privacy Policy</a
      >
    </div>
  </div>
</footer>
