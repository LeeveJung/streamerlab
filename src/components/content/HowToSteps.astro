---
// HowToSteps.astro - nummerierte Anleitung als semantische <ol>.
import type { HowToStep } from "../../scripts/home-content";

interface Props {
  heading: string;
  steps: HowToStep[];
}

const { heading, steps } = Astro.props;
---

<section class="max-w-3xl mx-auto space-y-6">
  <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
    {heading}
  </h2>

  <ol class="space-y-5">
    {
      steps.map((step, index) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-8 h-8 rounded-full bg-red-600/15 border border-red-500/40 text-red-400 text-sm font-bold flex items-center justify-center"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <div class="space-y-1.5 pt-0.5">
            <h3 class="text-base sm:text-lg font-semibold text-white">
              {step.name}
            </h3>
            <p class="max-w-prose text-base leading-relaxed text-zinc-300">
              {step.text}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
