---
// PreviewStage.astro - Rendert dynamic videoTitle
---

<div
  class="w-full bg-zinc-900 border border-zinc-800 rounded-xl p-4 sm:p-6 shadow-xl space-y-4"
>
  <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
    <span class="text-sm font-semibold text-zinc-400 uppercase tracking-wider">
      Feed Preview
    </span>
    <div
      id="view-switcher"
      class="flex bg-zinc-950 p-1 rounded-lg border border-zinc-800"
    >
      <button
        type="button"
        data-view="desktop"
        class="view-btn px-3 py-1.5 text-sm font-medium rounded-md transition-all text-white bg-zinc-800 shadow"
        >Desktop</button
      >
      <button
        type="button"
        data-view="mobile"
        class="view-btn px-3 py-1.5 text-sm font-medium rounded-md transition-all text-zinc-400 hover:text-white"
        >Mobile App</button
      >
    </div>
  </div>

  <div
    id="stage-wrapper"
    class="w-full max-w-full mx-auto transition-all duration-300"
  >
    <div
      id="preview-stage-container"
      class="relative w-full aspect-video rounded-xl overflow-hidden bg-zinc-950 border border-zinc-800/80 group"
    >
      <div
        id="preview-placeholder"
        class="absolute inset-0 flex flex-col items-center justify-center text-zinc-600 p-6 text-center select-none"
      >
        <svg
          class="w-12 h-12 mb-2 text-zinc-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
          ></path>
        </svg>
        <p class="text-sm font-medium text-zinc-400">No thumbnail loaded</p>
      </div>

      <img
        id="preview-image"
        class="hidden w-full h-full object-cover transition-[filter] duration-200"
        alt="YouTube Thumbnail Preview"
      />

      <div
        id="danger-zone-overlay"
        class="absolute bottom-0 right-0 w-[28%] h-[35%] bg-red-500/20 border-t-2 border-l-2 border-dashed border-red-500/60 pointer-events-none flex items-end justify-end p-2 transition-opacity duration-200"
      >
        <span
          class="text-[9px] font-mono font-bold tracking-wider uppercase text-red-300 bg-red-950/80 px-1 py-0.5 rounded border border-red-500/40"
          >Safe-Zone Danger</span
        >
      </div>

      <div
        id="badge-overlay"
        class="absolute bottom-2 right-2 font-sans text-[12px] leading-[12px] font-medium px-[4px] py-[3px] rounded-[4px] shadow-md pointer-events-none select-none bg-black/80 text-white"
      >
        10:42
      </div>

      <div
        id="progress-bar-overlay"
        class="absolute bottom-0 left-0 right-0 h-1 bg-zinc-800/80 pointer-events-none"
      >
        <div class="h-full w-2/5 bg-red-600"></div>
      </div>
    </div>

    <!-- DESKTOP Meta -->
    <div id="desktop-meta" class="mt-3 flex items-start select-none">
      <div
        class="avatar-icon w-[36px] h-[36px] rounded-full bg-zinc-700 shrink-0 mr-[12px] flex items-center justify-center font-bold text-xs text-zinc-300 uppercase"
      >
        YT
      </div>
      <div class="flex-1 space-y-0.5">
        <p
          class="text-[16px] leading-[22px] font-medium text-[#f1f1f1] line-clamp-2 video-title-text"
        >
          Your epic video title in the YouTube feed preview...
        </p>
        <p
          class="text-[14px] leading-[20px] font-normal text-[#aaa] hover:text-white cursor-pointer transition-colors channel-name-text"
        >
          Your Channel Name
        </p>
        <p class="text-[14px] leading-[20px] font-normal text-[#aaa]">
          145K views • 2 days ago
        </p>
      </div>
      <button type="button" class="text-zinc-400 hover:text-white p-1">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
          ><path
            d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
          ></path></svg
        >
      </button>
    </div>

    <!-- MOBILE Meta -->
    <div id="mobile-meta" class="hidden mt-3 px-1 flex items-start select-none">
      <div
        class="avatar-icon w-[36px] h-[36px] rounded-full bg-zinc-700 shrink-0 mr-[12px] flex items-center justify-center font-bold text-xs text-zinc-300 uppercase"
      >
        YT
      </div>
      <div class="flex-1 space-y-0.5">
        <p
          class="text-[14px] leading-[20px] font-normal text-[#f1f1f1] line-clamp-2 video-title-text"
        >
          Your epic video title in the YouTube feed preview...
        </p>
        <p
          class="text-[12px] leading-[18px] font-normal text-[#aaa] flex items-center gap-1"
        >
          <span class="channel-name-text">Your Channel Name</span> • 145K views
          • 2 days ago
        </p>
      </div>
      <button type="button" class="text-zinc-400 hover:text-white p-1">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
          ><path
            d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
          ></path></svg
        >
      </button>
    </div>
  </div>
</div>

<script>
  import {
    ThumbnailEngine,
    type ViewContext,
  } from "../../scripts/thumbnail-engine";

  const engine = ThumbnailEngine.getInstance();

  const imgElement = document.getElementById(
    "preview-image",
  ) as HTMLImageElement;
  const placeholder = document.getElementById("preview-placeholder");
  const dangerZone = document.getElementById("danger-zone-overlay");
  const badge = document.getElementById("badge-overlay");
  const progressBar = document.getElementById("progress-bar-overlay");

  const stageWrapper = document.getElementById("stage-wrapper");
  const desktopMeta = document.getElementById("desktop-meta");
  const mobileMeta = document.getElementById("mobile-meta");
  const viewBtns = document.querySelectorAll<HTMLButtonElement>(".view-btn");

  viewBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const viewContext = btn.getAttribute("data-view") as ViewContext;
      engine.updateState({ viewContext });
    });
  });

  engine.subscribe((state) => {
    if (state.imageSrc) {
      imgElement.src = state.imageSrc;
      imgElement.classList.remove("hidden");
      placeholder?.classList.add("hidden");
    } else {
      imgElement.classList.add("hidden");
      placeholder?.classList.remove("hidden");
    }

    imgElement.style.filter =
      state.blurLevel > 0 ? `blur(${state.blurLevel}px)` : "none";
    dangerZone?.classList.toggle("opacity-0", !state.showDangerZone);
    progressBar?.classList.toggle("hidden", !state.showProgressBar);

    if (badge) {
      if (state.badgeType === "none") {
        badge.classList.add("hidden");
      } else {
        badge.classList.remove("hidden");
        badge.textContent = state.badgeText;
        badge.className =
          state.badgeType === "live"
            ? "absolute bottom-2 right-2 font-bold text-[11px] leading-[11px] bg-red-600 text-white px-[4px] py-[3px] rounded-[4px] shadow-md pointer-events-none select-none uppercase"
            : "absolute bottom-2 right-2 font-medium text-[12px] leading-[12px] bg-black/80 text-white px-[4px] py-[3px] rounded-[4px] shadow-md pointer-events-none select-none";
      }
    }

    // Dynamic Video Title Sync
    const titleElements = document.querySelectorAll(".video-title-text");
    titleElements.forEach((el) => {
      el.textContent = state.videoTitle;
    });

    // Dynamic Channel Name & Initials Sync
    const channelTexts = document.querySelectorAll(".channel-name-text");
    channelTexts.forEach((el) => {
      el.textContent = state.channelName;
    });

    const initials =
      state.channelName
        .trim()
        .split(" ")
        .filter(Boolean)
        .map((word) => word[0])
        .join("")
        .slice(0, 2) || "YT";

    const avatarIcons = document.querySelectorAll(".avatar-icon");
    avatarIcons.forEach((el) => {
      el.textContent = initials;
    });

    const isMobile = state.viewContext === "mobile";

    if (stageWrapper) {
      if (isMobile) {
        stageWrapper.className =
          "w-full max-w-[380px] mx-auto transition-all duration-300";
        desktopMeta?.classList.add("hidden");
        mobileMeta?.classList.remove("hidden");
      } else {
        stageWrapper.className =
          "w-full max-w-full mx-auto transition-all duration-300";
        desktopMeta?.classList.remove("hidden");
        mobileMeta?.classList.add("hidden");
      }
    }

    viewBtns.forEach((btn) => {
      const active = btn.getAttribute("data-view") === state.viewContext;
      btn.className = active
        ? "view-btn px-3 py-1.5 text-sm font-medium rounded-md transition-all text-white bg-zinc-800 shadow"
        : "view-btn px-3 py-1.5 text-sm font-medium rounded-md transition-all text-zinc-400 hover:text-white";
    });
  });
</script>
