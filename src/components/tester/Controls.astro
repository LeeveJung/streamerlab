---
// Controls.astro - Control Panel mit Kanalname & Videotitel
---

<div
  class="w-full bg-zinc-900 border border-zinc-800 rounded-xl p-4 sm:p-6 shadow-xl space-y-6"
>
  <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
    <h2
      class="text-base font-semibold text-white tracking-wide uppercase flex items-center gap-2"
    >
      <svg
        class="w-4 h-4 text-red-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
        ></path>
      </svg>
      Settings
    </h2>
  </div>

  <!-- Metadata inputs -->
  <div class="space-y-3">
    <div>
      <label
        for="channel-name-input"
        class="text-sm font-medium text-zinc-400 uppercase tracking-wider block mb-1"
      >
        Channel Name
      </label>
      <input
        type="text"
        id="channel-name-input"
        placeholder="e.g. Creator Studio"
        class="w-full px-3 py-2 text-sm bg-zinc-950 border border-zinc-800 rounded-lg text-white placeholder-zinc-600 focus:outline-none focus:border-red-500 transition-colors"
      />
    </div>

    <div>
      <label
        for="video-title-input"
        class="text-sm font-medium text-zinc-400 uppercase tracking-wider block mb-1"
      >
        Video Title (line-break test)
      </label>
      <textarea
        id="video-title-input"
        rows="2"
        placeholder="Type your video title here..."
        class="w-full px-3 py-2 text-sm bg-zinc-950 border border-zinc-800 rounded-lg text-white placeholder-zinc-600 focus:outline-none focus:border-red-500 transition-colors resize-none"
      ></textarea>
    </div>
  </div>

  <!-- Badge selector -->
  <div class="space-y-2 pt-2 border-t border-zinc-800/80">
    <label class="text-sm font-medium text-zinc-400 uppercase tracking-wider">
      Timestamp Badge
    </label>
    <div id="badge-selector" class="grid grid-cols-2 sm:grid-cols-4 gap-2">
      <button
        type="button"
        data-badge="short"
        class="badge-btn px-3 py-2 text-sm font-medium rounded-lg border border-zinc-700 bg-zinc-800 text-zinc-300 hover:border-zinc-500 transition-all text-center"
        >Short</button
      >
      <button
        type="button"
        data-badge="long"
        class="badge-btn px-3 py-2 text-sm font-medium rounded-lg border border-zinc-700 bg-zinc-800 text-zinc-300 hover:border-zinc-500 transition-all text-center"
        >Long</button
      >
      <button
        type="button"
        data-badge="live"
        class="badge-btn px-3 py-2 text-sm font-medium rounded-lg border border-zinc-700 bg-zinc-800 text-zinc-300 hover:border-zinc-500 transition-all text-center"
        >LIVE</button
      >
      <button
        type="button"
        data-badge="none"
        class="badge-btn px-3 py-2 text-sm font-medium rounded-lg border border-zinc-700 bg-zinc-800 text-zinc-300 hover:border-zinc-500 transition-all text-center"
        >None</button
      >
    </div>
  </div>

  <!-- Safe-Zone & Progress Toggles -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-zinc-800/80"
  >
    <label
      class="flex items-center justify-between p-3 rounded-lg bg-zinc-950/60 border border-zinc-800 cursor-pointer hover:border-zinc-700 transition-colors"
    >
      <span class="text-sm font-medium text-zinc-300">Danger-Zone</span>
      <input
        type="checkbox"
        id="toggle-danger-zone"
        class="accent-red-500 w-4 h-4 rounded cursor-pointer bg-zinc-800 border-zinc-700"
      />
    </label>

    <label
      class="flex items-center justify-between p-3 rounded-lg bg-zinc-950/60 border border-zinc-800 cursor-pointer hover:border-zinc-700 transition-colors"
    >
      <span class="text-sm font-medium text-zinc-300">Progress Bar</span>
      <input
        type="checkbox"
        id="toggle-progress-bar"
        class="accent-red-500 w-4 h-4 rounded cursor-pointer bg-zinc-800 border-zinc-700"
      />
    </label>
  </div>

  <!-- Blur filter -->
  <div class="space-y-2 pt-2 border-t border-zinc-800/80">
    <div class="flex justify-between items-center">
      <label
        for="blur-slider"
        class="text-sm font-medium text-zinc-400 uppercase tracking-wider"
      >
        Blur Test (focus check)
      </label>
      <span id="blur-value" class="text-sm font-mono text-zinc-400">0px</span>
    </div>
    <input
      type="range"
      id="blur-slider"
      min="0"
      max="8"
      value="0"
      step="1"
      class="w-full accent-red-500 bg-zinc-800 h-2 rounded-lg cursor-pointer"
    />
  </div>
</div>

<script>
  import {
    ThumbnailEngine,
    type BadgeType,
  } from "../../scripts/thumbnail-engine";

  const engine = ThumbnailEngine.getInstance();

  const channelInput = document.getElementById(
    "channel-name-input",
  ) as HTMLInputElement;
  const titleInput = document.getElementById(
    "video-title-input",
  ) as HTMLTextAreaElement;
  const badgeButtons =
    document.querySelectorAll<HTMLButtonElement>(".badge-btn");
  const toggleDangerZone = document.getElementById(
    "toggle-danger-zone",
  ) as HTMLInputElement;
  const toggleProgressBar = document.getElementById(
    "toggle-progress-bar",
  ) as HTMLInputElement;
  const blurSlider = document.getElementById("blur-slider") as HTMLInputElement;
  const blurValueText = document.getElementById("blur-value");

  // Input Listeners
  channelInput?.addEventListener("input", (e) => {
    const val = (e.target as HTMLInputElement).value;
    engine.updateState({ channelName: val || "Your Channel Name" });
  });

  titleInput?.addEventListener("input", (e) => {
    const val = (e.target as HTMLTextAreaElement).value;
    engine.updateState({
      videoTitle: val || "Your epic video title in the YouTube feed preview...",
    });
  });

  // Badge Listeners
  badgeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const badgeType = btn.getAttribute("data-badge") as BadgeType;
      engine.updateState({ badgeType });
    });
  });

  toggleDangerZone?.addEventListener("change", (e) => {
    engine.updateState({
      showDangerZone: (e.target as HTMLInputElement).checked,
    });
  });

  toggleProgressBar?.addEventListener("change", (e) => {
    engine.updateState({
      showProgressBar: (e.target as HTMLInputElement).checked,
    });
  });

  blurSlider?.addEventListener("input", (e) => {
    const value = parseInt((e.target as HTMLInputElement).value, 10);
    engine.updateState({ blurLevel: value });
  });

  // UI Sync
  engine.subscribe((state) => {
    if (channelInput && document.activeElement !== channelInput) {
      channelInput.value = state.channelName;
    }
    if (titleInput && document.activeElement !== titleInput) {
      titleInput.value = state.videoTitle;
    }

    badgeButtons.forEach((btn) => {
      const isSelected = btn.getAttribute("data-badge") === state.badgeType;
      btn.className = isSelected
        ? "badge-btn px-3 py-2 text-sm font-medium rounded-lg border border-red-500 bg-red-500/10 text-white transition-all text-center"
        : "badge-btn px-3 py-2 text-sm font-medium rounded-lg border border-zinc-700 bg-zinc-800 text-zinc-400 hover:border-zinc-500 transition-all text-center";
    });

    if (toggleDangerZone) toggleDangerZone.checked = state.showDangerZone;
    if (toggleProgressBar) toggleProgressBar.checked = state.showProgressBar;
    if (blurSlider) blurSlider.value = state.blurLevel.toString();
    if (blurValueText) blurValueText.textContent = `${state.blurLevel}px`;
  });
</script>
