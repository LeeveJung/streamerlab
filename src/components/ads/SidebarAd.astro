---
import { SITE_CONFIG } from "../../config";

interface Props {
  slotId?: string;
}

const { slotId = "0987654321" } = Astro.props;
---

{
  SITE_CONFIG.showAds && (
    <div class="w-full h-[250px] bg-zinc-900/40 border border-zinc-800/60 rounded-lg flex items-center justify-center overflow-hidden">
      <ins
        class="adsbygoogle"
        style="display:block; width:100%; height:250px;"
        data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
        data-ad-slot={slotId}
        data-ad-format="rectangle"
      />
    </div>
  )
}
