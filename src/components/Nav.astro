---
// Nav.astro - Header mit interner Verlinkung aller Tool-Seiten.
// Ohne diese Links waeren die Landingpages fuer Crawler nicht erreichbar.
import { SEO_PAGES } from "../scripts/seo-pages";

const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Thumbnail Tester" },
  ...SEO_PAGES.map((page) => ({ href: `/${page.slug}/`, label: page.navLabel })),
];

const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="w-full border-b border-zinc-800/80 bg-zinc-950/95 sticky top-0 z-40 backdrop-blur">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6"
  >
    <a
      href="/"
      class="flex items-center gap-2 font-bold text-sm text-white shrink-0 hover:text-red-400 transition-colors"
    >
      <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 00.5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.5 15.6V8.4l6.3 3.6-6.3 3.6z"
        ></path>
      </svg>
      Thumbnail Tester
    </a>

    <nav aria-label="Tools" class="flex flex-wrap items-center gap-x-5 gap-y-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class:list={[
              "text-xs font-medium transition-colors",
              isCurrent(link.href)
                ? "text-white border-b border-red-500 pb-0.5"
                : "text-zinc-400 hover:text-zinc-100",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
