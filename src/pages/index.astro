---
import BaseLayout from "../layouts/BaseLayout.astro";
import DropZone from "../components/tester/DropZone.astro";
import PreviewStage from "../components/tester/PreviewStage.astro";
import Controls from "../components/tester/Controls.astro";
import LeaderboardAd from "../components/ads/LeaderboardAd.astro";
import SidebarAd from "../components/ads/SidebarAd.astro";
---

<BaseLayout
  title="YouTube Thumbnail & Safe-Zone Tester | Kostenloses Preview Tool"
  description="Prüfe dein YouTube-Thumbnail auf Safe-Zones, Badge-Abdeckungen durch Zeitstempel und Lesbarkeit auf Mobilgeräten."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header -->
    <header class="text-center max-w-3xl mx-auto space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        YouTube Thumbnail & Safe-Zone Tester
      </h1>
      <p class="text-sm sm:text-base text-zinc-400">
        Optimiere dein Thumbnail für hohe Click-Through-Rates (CTR). Prüfe
        verdeckte Ecken und Unschärfe auf Smartphones.
      </p>
    </header>

    <!-- Leaderboard Ad Slot (CLS-geschützt) -->
    <div class="flex justify-center">
      <LeaderboardAd />
    </div>

    <!-- Upload DropZone -->
    <section class="max-w-4xl mx-auto">
      <DropZone />
    </section>

    <!-- Workspace Grid -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      <!-- Left Column: Canvas Preview (2/3 Breite) -->
      <div class="lg:col-span-2 space-y-6">
        <PreviewStage />
      </div>

      <!-- Right Column: Controls & Sticky Ad (1/3 Breite) -->
      <div class="space-y-6 lg:sticky lg:top-8">
        <Controls />
        <SidebarAd />
      </div>
    </section>
  </main>
</BaseLayout>
